---
// src/components/ImageWithFallback.astro
// Component voor afbeeldingen met fallback-functionaliteit
// Gebruik: <ImageWithFallback src="/path/to/image.jpg" alt="Beschrijving" width={800} height={450} fallbackSrc="/fallback/image-not-found.svg" />

import { Image } from 'astro:assets';

// Definieer de props interface
interface ImageProps {
  src: string | { src: string };
  alt: string;
  width: number;
  height: number;
  fallbackSrc?: string;
  loading?: 'lazy' | 'eager';
  [key: string]: any;
}

// Haal de props op met TypeScript type
const { 
  src, 
  alt, 
  fallbackSrc = '/fallback/image-not-found.svg',
  loading = 'lazy',
  width,
  height,
  ...restProps 
} = Astro.props as ImageProps;

// Controleer of de bron een geïmporteerde asset is of een pad
const isImportedAsset = typeof src === 'object' && 'src' in src;
const imageSrc = isImportedAsset ? src : { src };

// Controleer of het een SVG-bestand is
const isSvg = typeof src === 'string' 
  ? src.toLowerCase().endsWith('.svg')
  : src?.src?.toLowerCase()?.endsWith('.svg');

// Valideer verplichte props
if (!alt) {
  console.warn('ImageWithFallback: Het `alt` attribuut is verplicht voor toegankelijkheid');
}

// Valideer afmetingen
if (!width || !height) {
  console.warn('ImageWithFallback: `width` en `height` attributen worden aanbevolen voor Cumulative Layout Shift (CLS) optimalisatie');
}

// Bouw de image props op
const baseProps = {
  alt: alt || 'Afbeelding',
  loading,
  class: "image-content",
  width,
  height,
  ...restProps
};

const errorHandler = `(function(e) {
  if (e.target.src !== '${fallbackSrc}') {
    e.target.src = '${fallbackSrc}';
    e.target.onerror = null;
  }
})(event)`;
---

<figure class="image-container">
  {isSvg ? (
    // Toon SVG zonder optimalisatie
    <img
      src={isImportedAsset ? imageSrc.src : src as string}
      alt={alt || 'Afbeelding'}
      loading={loading}
      class="image-content"
      on:click={errorHandler}
      width={width}
      height={height}
      {...restProps}
    />
  ) : (
    // Gebruik Astro's Image voor geoptimaliseerde afbeeldingen
    <Image
      src={imageSrc}
      {...baseProps}
      format="webp"
      on:click={errorHandler}
    />
  )}
  {alt && <figcaption class="image-caption">{alt}</figcaption>}
</figure>

<style>
  .image-container {
    margin: 1.5rem 0;
    text-align: center;
  }
  
  .image-content {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  
  .image-caption {
    margin-top: 0.5rem;
    font-size: 0.9em;
    color: var(--sl-color-text);
    opacity: 0.8;
  }
</style>
